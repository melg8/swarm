# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.task
# Local staging of the downloaded geodata pack (not part of the repo)
.tmp-geodata/

# The persistent session journals of the bot runs (the session dump
# artifacts, see docs/session_journal.md)
logs/
proxy.log

# The offline navmesh tile build output (cmd/navmesh-build, derived
# from the tracked geodata pack - 1.9 GB for the full 165 regions,
# rebuildable in ~4.5 minutes)
data/navmesh/

# The repair backups of the concatenated geodata files (scripts/geo_repair).
*.l2j.orig

# The cargo build artifacts of the l2bridge harness
tools/l2bridge/target/

# The runtime artifacts of tools/coverage_delta.sh (the raw run
# log and the current run summary - the committed baseline is
# runs/coverage-latest.txt)
runs/.cover-run.log
runs/.coverage-current.txt

# The runtime artifact of the full repo race run (the per package
# results land in the terminal and the commit message - the log
# itself is not a baseline)
runs/race_full.log

# The fleet profile artifacts (the binary pprof dumps and the journal
# files the 40 bot instrument writes; the report lands in the commit
# message and the docs instead).
runs/fleetprofile/
