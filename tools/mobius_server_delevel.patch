# Server-side fixes of the L2J Mobius C1 pack required for the guard
# deleveling of the swarm bot (verified end to end on the sandbox stack).
#
# 1. Player.isAutoAttackable: guards retaliate - a player who damaged
#    the guard is in its aggro list and stays a valid target, so the
#    provoked guard walks over and strikes back instead of standing at
#    its post (the root cause of 'the guard does not fight back').
# 2. Player.doDie: the death exp penalty also applies to NPC killers
#    (guards, mobs). Upstream runs the penalty only for playable
#    killers, so a death to a guard lost no experience at all and the
#    level never dropped (the delevel looped forever).
# 3. Guard.addDamage: drop the startFollow churn, keep the hate boost
#    (a 1 damage provocation leaves the guard nearly indifferent with
#    the stock hate formula) and a GUARDDMG diagnostic log line.
#
# Apply from the l2j_mobius repository root:
#   git apply --ignore-space-change mobius_server_delevel.patch
# then recompile the server (javac) and restart the game server.
#
diff --git a/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/Player.java b/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/Player.java
index e97bb17f..600bbbee 100644
--- a/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/Player.java
+++ b/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/Player.java
@@ -4491,6 +4491,22 @@ public class Player extends Playable
                                 calculateDeathExpPenalty(killer, isAtWarWith(pk));
                         }
                 }
+                else
+                {
+                        // NPC kills (monsters, guards) carry the same death
+                        // experience penalty: the playable-only gate above made
+                        // every death to a guard or a mob lose no experience
+                        // at all, so the deleveling at the town guards never
+                        // progressed (the level simply never dropped).
+                        setExpBeforeDeath(0);
+                        
+                        // Should not penalize player when lucky, in a non siege PvP zone or is in an event.
+                        if (PlayerConfig.PLAYER_DELEVEL && !isLucky() && !isInsideZone(ZoneId.PVP) && !isOnEvent())
+                        {
+                                calculateDeathExpPenalty(killer, false);
+                                broadcastStatusUpdate();
+                        }
+                }
                 
                 // Unsummon Cubics
                 if (!_cubics.isEmpty())
@@ -7355,7 +7371,14 @@ public class Player extends Playable
                                 return true;
                         }
 
-			return (getKarma() > 0); // Guards attack only PK players.
+                        // Retail guards retaliate: a player who damaged the guard
+                        // sits in its aggro list (Attackable.addDamageHate runs
+                        // before the AI decides), so the guard may treat that
+                        // player as a valid target, walk over and strike back.
+                        // Without this the AttackableAI.checkTarget gate makes a
+                        // karma-free provoker unattackable and the guard just
+                        // stands at its post (the deleveling failure).
+                        return (getKarma() > 0) || ((Guard) attacker).isInAggroList(this); // Guards attack PK players and their attackers.
                 }
                 
                 // Check if the Player has Karma.
diff --git a/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/instance/Guard.java b/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/instance/Guard.java
index bfcf0894..cff49f63 100644
--- a/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/instance/Guard.java
+++ b/L2J_Mobius_C1_HarbingersOfWar/java/org/l2jmobius/gameserver/entity/actor/instance/Guard.java
@@ -72,11 +72,16 @@ public class Guard extends Attackable
         public void addDamage(Creature attacker, int damage, Skill skill)
         {
                 super.addDamage(attacker, damage, skill);
-		getAI().startFollow(attacker);
+                LOGGER.info(String.format("GUARDDMG guard %d (%s) took %d damage from %s at (%d, %d, %d)", getObjectId(), getName(), damage, attacker.getName(), getX(), getY(), getZ()));
+                // Ensure the attacker becomes the most hated target even when the
+                // hit is tiny (a low level provocation): the stock hate formula
+                // (damage * 100 / (level + 7)) scales the hate down with the
+                // guard level and a 1 damage poke leaves the guard nearly
+                // indifferent, so the retaliation never starts.
                 addDamageHate(attacker, 0, 10);
+                // Guards standing nearby join the retaliation.
                 World.forEachVisibleObjectInRange(this, Guard.class, 500, guard ->
                 {
-			guard.getAI().startFollow(attacker);
                         guard.addDamageHate(attacker, 0, 10);
                 });
         }
